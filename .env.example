# Swaggybark Beklenti Paneli — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala:  cp .env.example .env

# MongoDB (Atlas ücretsiz M0 yeterli)
MONGODB_URI=mongodb+srv://kullanici:sifre@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=swaggybark

# Oy kimliği karıştırma anahtarı (RASSAL ve gizli bir string üret: openssl rand -hex 32)
VOTE_SECRET=bunu-degistir-uzun-rassal-dizgi

# Kick kanal adı (varsayılan: swaggybark)
KICK_CHANNEL=swaggybark

# Manuel "oylamayı kapat" anahtarı (yayıncı yedeği). Boşsa manuel kapatma kapalı.
ADMIN_KEY=
